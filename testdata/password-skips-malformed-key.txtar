env RESTIC_REPOSITORY=$WORK/repo
exec restic init --password-file password.txt

exec restic-age-key add --password-file password.txt --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7
json-find $RESTIC_REPOSITORY/keys age-pubkey=age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7
capture-output VALID_ID

json-set $RESTIC_REPOSITORY/keys/$VALID_ID corrupt1.json kdf=bogus hostname=corrupt1.local
sha256 corrupt1.json CORRUPT1_ID
cp corrupt1.json $RESTIC_REPOSITORY/keys/$CORRUPT1_ID

json-set $RESTIC_REPOSITORY/keys/$VALID_ID corrupt2.json kdf=bogus hostname=corrupt2.local
sha256 corrupt2.json CORRUPT2_ID
cp corrupt2.json $RESTIC_REPOSITORY/keys/$CORRUPT2_ID

json-set $RESTIC_REPOSITORY/keys/$VALID_ID corrupt3.json kdf=bogus hostname=corrupt3.local
sha256 corrupt3.json CORRUPT3_ID
cp corrupt3.json $RESTIC_REPOSITORY/keys/$CORRUPT3_ID

exec restic-age-key password --identity-file key.txt --output recovered-password.txt
! stderr .
grep '^[a-f0-9]{64}$' recovered-password.txt

-- password.txt --
secret

-- key.txt --
AGE-SECRET-KEY-16HXZ3F6C8JSN9NDFCD8XLGHKS7L39M5PVCS3A53DXX5WT9SPV65Q08EAAY
