env RESTIC_REPOSITORY=$WORK/repo
exec restic init --password-file password.txt

exec restic-age-key add --password-file password.txt --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7
json-find $RESTIC_REPOSITORY/keys age-pubkey=age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7
capture-output FIRST_ID
mv $RESTIC_REPOSITORY/keys/$FIRST_ID first-key.json

exec restic-age-key add --password-file password.txt --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7
json-find $RESTIC_REPOSITORY/keys age-pubkey=age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7
capture-output SECOND_ID
cp $RESTIC_REPOSITORY/keys/$SECOND_ID second-key.json

json-get first-key.json age-data
capture-output FIRST_AGE_DATA
json-set second-key.json mismatched-key.json age-data=$FIRST_AGE_DATA
sha256 mismatched-key.json MISMATCHED_ID
cp mismatched-key.json $RESTIC_REPOSITORY/keys/$MISMATCHED_ID
rm $RESTIC_REPOSITORY/keys/$SECOND_ID

! exec restic-age-key password --identity-file key.txt --output recovered-password.txt
stderr 'does not open key'
! exists recovered-password.txt

-- password.txt --
secret

-- key.txt --
AGE-SECRET-KEY-16HXZ3F6C8JSN9NDFCD8XLGHKS7L39M5PVCS3A53DXX5WT9SPV65Q08EAAY
