env RESTIC_REPOSITORY=$WORK/repo

exec restic init --password-file=$WORK/password.txt

exec restic-age-key add --password-file=$WORK/password.txt --recipient=age15xz8e5kyjguheag9a99nmwfrf5z3wr9729x2nhdk8zdfcny7a4wqtyl0rn
exec restic-age-key add --password-file=$WORK/password.txt --recipient=age17vcqt2rtn3eqqtud8448tqnev6utce8cz8ddwpl7yyxrfzpjuudq8eplr9 --user=carol --host=old.local

! exec restic-age-key set --identity-file=$WORK/key.txt --recipients-file=recipients.json
cmp stderr set-stderr.txt

exec restic-age-key list --password-file=$WORK/password.txt
stdout 'age15xz8e5kyjguheag9a99nmwfrf5z3wr9729x2nhdk8zdfcny7a4wqtyl0rn'
! stdout 'age17vcqt2rtn3eqqtud8448tqnev6utce8cz8ddwpl7yyxrfzpjuudq8eplr9\s+carol\s+old.local'
stdout 'age17vcqt2rtn3eqqtud8448tqnev6utce8cz8ddwpl7yyxrfzpjuudq8eplr9\s+alice\s+old.local'
stdout 'age1yyc2s8dmtv4ljvsfjd8lmqgua97fwz20t0t8wgq02cjz4va86gxqcc9lw4'

exec restic key list --no-cache --json --password-file $WORK/password.txt
json-len stdout
stdout 4

exec restic-age-key set --identity-file=$WORK/key.txt --recipients-file=recipients.json
! stderr 'Add key'
stderr 'Remove key age15xz8e5kyjguheag9a99nmwfrf5z3wr9729x2nhdk8zdfcny7a4wqtyl0rn'
! stderr 'Remove key age17vcqt2rtn3eqqtud8448tqnev6utce8cz8ddwpl7yyxrfzpjuudq8eplr9'
! stderr 'refusing to remove key currently used'

exec restic-age-key list --password-file=$WORK/password.txt
! stdout 'age15xz8e5kyjguheag9a99nmwfrf5z3wr9729x2nhdk8zdfcny7a4wqtyl0rn'
stdout 'age17vcqt2rtn3eqqtud8448tqnev6utce8cz8ddwpl7yyxrfzpjuudq8eplr9\s+alice\s+old.local'
! stdout 'age17vcqt2rtn3eqqtud8448tqnev6utce8cz8ddwpl7yyxrfzpjuudq8eplr9\s+carol\s+old.local'
stdout 'age1yyc2s8dmtv4ljvsfjd8lmqgua97fwz20t0t8wgq02cjz4va86gxqcc9lw4'

exec restic key list --no-cache --json --password-file $WORK/password.txt
json-len stdout
stdout 3

