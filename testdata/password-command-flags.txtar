exec restic init --repo $WORK/repo --password-command 'print-file password.txt'

exec restic-age-key add --repo $WORK/repo --password-command 'print-file password.txt' --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7

exec restic-age-key password --repo $WORK/repo --identity-command 'print-file key.txt' --output password2.txt
! stdout .
! stderr .

grep '^[a-f0-9]{64}$' password2.txt

exec restic check --repo $WORK/repo --password-command 'print-file password2.txt'
! stderr .

