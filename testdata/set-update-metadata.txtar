env RESTIC_REPOSITORY=$WORK/repo
env RESTIC_PASSWORD_FILE=$WORK/password.txt

exec restic init

exec restic-age-key add --recipient=age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw --user=alice --host=alice.local
exec restic-age-key add --recipient=age1ljfnltkzeynhjhe928gap0jn4jlwxfwstaf2pcas3y72fv35d9qq43lvvr --user=bob --host=old.local

exec restic-age-key set --recipients-file=recipients.json
stderr 'Add key age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw for carol@alice.local'
stderr 'Add key age1ljfnltkzeynhjhe928gap0jn4jlwxfwstaf2pcas3y72fv35d9qq43lvvr for bob@new.local'
stderr 'Remove key age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw for alice@alice.local'
stderr 'Remove key age1ljfnltkzeynhjhe928gap0jn4jlwxfwstaf2pcas3y72fv35d9qq43lvvr for bob@old.local'

exec restic-age-key list
stdout 'age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw\s+carol\s+alice.local'
stdout 'age1ljfnltkzeynhjhe928gap0jn4jlwxfwstaf2pcas3y72fv35d9qq43lvvr\s+bob\s+new.local'
! stdout 'age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw\s+alice\s+alice.local'
! stdout 'age1ljfnltkzeynhjhe928gap0jn4jlwxfwstaf2pcas3y72fv35d9qq43lvvr\s+bob\s+old.local'

exec bash restic-key-count.bash
stdout 3
! stderr .

exec restic-age-key set --recipients-file=recipients.json
! stdout .
! stderr .

exec bash restic-key-count.bash
stdout 3
! stderr .

-- password.txt --
secret

-- recipients.json --
[
    { "host": "alice.local", "user": "carol", "pubkey": "age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw" },
    { "host": "new.local", "user": "bob", "pubkey": "age1ljfnltkzeynhjhe928gap0jn4jlwxfwstaf2pcas3y72fv35d9qq43lvvr" }
]

-- restic-key-count.bash --
restic key list --no-cache --json | jq length
