exec chmod +x $WORK/slow-rclone

! exec restic-age-key --rclone-program $WORK/slow-rclone --timeout 1s repo-init --if-not-exists --repo rclone:local:foo:/bar --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7
