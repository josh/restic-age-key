env RESTIC_REPOSITORY=$WORK/repo
env RESTIC_PASSWORD_FILE=$WORK/password.txt

exec restic init

[root] skip 'root ignores file permissions'
chmod 000 $WORK/repo

! exec restic-age-key list
! stdout .
stderr 'unable to open config file'
stderr 'permission denied'

chmod 755 $WORK/repo

-- password.txt --
secret
