env RESTIC_REPOSITORY=$WORK/repo

exec restic-age-key repo-init --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7 --identity-file $WORK/key.txt --user alice --host old.local --output old-keyid.txt
stderr 'age key [a-f0-9]{8} for alice@old.local'

exec restic-age-key password --identity-file $WORK/key.txt --output current-password.txt
! stdout .
! stderr .
exec restic key list --no-cache --json --password-file current-password.txt
json-filter stdout current=true
json-get stdout id
cp stdout old-keyid-full.txt
capture-output OLD_KEYID
cp $RESTIC_REPOSITORY/keys/$OLD_KEYID old-key.json
json-del old-key.json old-key-content.json hostname username
exec restic-age-key list --identity-file $WORK/key.txt
stdout 'age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7\s+alice\s+old.local'
! stderr .

json-set old-key.json replacement-key.json hostname=new.local username=bob
sha256 replacement-key.json REPLACEMENT_ID
cp corrupt $RESTIC_REPOSITORY/keys/$REPLACEMENT_ID

exec restic-age-key set --identity-file=$WORK/key.txt --recipients-file=recipients.json
stderr 'Add key age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7 for bob@new.local'
stderr 'Remove key age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7 for alice@old.local'
! stderr 'refusing to remove key currently used'

exec restic-age-key list --identity-file $WORK/key.txt
stdout 'age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7\s+bob\s+new.local'
! stdout 'alice\s+old.local'
! stderr .

exec restic-age-key list --password-file current-password.txt
stdout 'age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7\s+bob\s+new.local'
! stderr .

exec restic key list --no-cache --json --password-file current-password.txt
json-filter stdout current=true
json-get stdout id
cp stdout new-keyid-full.txt
capture-output NEW_KEYID
! cmp old-keyid-full.txt new-keyid-full.txt
cp $RESTIC_REPOSITORY/keys/$NEW_KEYID new-key.json
json-del new-key.json new-key-content.json hostname username
cmp old-key-content.json new-key-content.json

exec restic key list --no-cache --json --password-file current-password.txt
json-len stdout
stdout 1
! stderr .

exec restic-age-key set --password-file=current-password.txt --recipients-file=recipients.json
! stdout .
! stderr .

-- corrupt --
corrupt

-- key.txt --
AGE-SECRET-KEY-16HXZ3F6C8JSN9NDFCD8XLGHKS7L39M5PVCS3A53DXX5WT9SPV65Q08EAAY

-- recipients.json --
[
    { "host": "new.local", "user": "bob", "pubkey": "age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7" }
]
