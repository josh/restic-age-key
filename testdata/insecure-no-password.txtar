env RESTIC_REPOSITORY=$WORK/repo
env RESTIC_AGE_USER=alice
env RESTIC_AGE_HOST=localhost

exec restic init --insecure-no-password

exec restic-age-key add --insecure-no-password --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7
stderr 'Add key age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7 for alice@localhost'

exec restic-age-key list --insecure-no-password
stdout age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7

! exec restic-age-key list --insecure-no-password --password secret
stderr 'insecure-no-password must not be specified together with providing a password'

env RESTIC_PASSWORD=secret
! exec restic-age-key list --insecure-no-password
stderr 'insecure-no-password must not be specified together with providing a password'
