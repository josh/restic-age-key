# A repository restic creates with an empty password is usable here too.

env RESTIC_REPOSITORY=$WORK/repo
exec restic init --insecure-no-password

exec restic-age-key add --insecure-no-password --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7
stderr 'Add key'

exec restic-age-key list --insecure-no-password
stdout 'age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7'

# The age key works without the flag, since it carries its own password.
exec restic-age-key password --identity-file $WORK/key.txt
stdout '^[a-f0-9]{64}$'

# restic still reads the repository after we have written to it.
exec restic key list --insecure-no-password
stdout 'ID'

exec restic-age-key set --insecure-no-password --recipients-file recipients.json
stderr 'Add key age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw'

# Without the flag an empty-password repository cannot be opened, as in restic.
! exec restic key list
! exec restic-age-key list
! stdout .
stderr 'no password given'

# The flag is refused alongside any password source, using restic's wording.
! exec restic key list --insecure-no-password --password-file $WORK/password.txt
stderr 'insecure-no-password'
! exec restic-age-key list --insecure-no-password --password-file $WORK/password.txt
! stdout .
cmp stderr conflict-stderr.txt

env RESTIC_PASSWORD=secret
! exec restic-age-key list --insecure-no-password
! stdout .
cmp stderr conflict-stderr.txt
env RESTIC_PASSWORD=

-- password.txt --
secret

-- key.txt --
AGE-SECRET-KEY-16HXZ3F6C8JSN9NDFCD8XLGHKS7L39M5PVCS3A53DXX5WT9SPV65Q08EAAY

-- recipients.json --
[
    { "user": "alice", "pubkey": "age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7" },
    { "user": "bob", "pubkey": "age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw" }
]

-- conflict-stderr.txt --
Fatal: --insecure-no-password must not be specified together with providing a password via a cli option or environment variable
