env RESTIC_REPOSITORY=$WORK/repo
env RESTIC_AGE_USER=alice
env RESTIC_AGE_HOST=localhost

exec restic init --insecure-no-password

exec restic-age-key add --insecure-no-password --recipient age1a2jgs9svf78df0tkk035uk0w7zrw670tr92kz4azrekydg277flswlk8p6
stderr 'Add key age1a2jgs9svf78df0tkk035uk0w7zrw670tr92kz4azrekydg277flswlk8p6 for alice@localhost'

exec restic-age-key list --insecure-no-password
stdout age1a2jgs9svf78df0tkk035uk0w7zrw670tr92kz4azrekydg277flswlk8p6

! exec restic-age-key list --insecure-no-password --password secret
stderr 'insecure-no-password must not be specified together with providing a password'

! exec restic-age-key list --insecure-no-password --password secret --identity-file key.txt
stderr 'insecure-no-password must not be specified together with providing a password'

env RESTIC_PASSWORD=secret
! exec restic-age-key list --insecure-no-password
stderr 'insecure-no-password must not be specified together with providing a password'
env RESTIC_PASSWORD=

exec restic-age-key list --identity-file key.txt
stdout age1a2jgs9svf78df0tkk035uk0w7zrw670tr92kz4azrekydg277flswlk8p6

exec restic-age-key repo-init --if-not-exists --insecure-no-password --recipients-file recipients.json
stderr 'repository already initialized'

exec restic-age-key repo-init --insecure-no-password --repo $WORK/repo2 --recipient age1a2jgs9svf78df0tkk035uk0w7zrw670tr92kz4azrekydg277flswlk8p6
stderr 'created restic repository'

