exec restic init --repo $WORK/repo-a --password-file password-a.txt
exec restic-age-key add --repo $WORK/repo-a --password-file password-a.txt --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7
json-find $WORK/repo-a/keys age-pubkey=age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7
capture-output A_KEY_ID
rm $WORK/repo-a/keys/$A_KEY_ID

exec restic init --repo $WORK/repo-b --password-file password-b.txt
exec restic-age-key add --repo $WORK/repo-b --password-file password-b.txt --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7
json-find $WORK/repo-b/keys age-pubkey=age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7
capture-output B_KEY_ID
cp $WORK/repo-b/keys/$B_KEY_ID $WORK/repo-a/keys/$B_KEY_ID

! exec restic-age-key password --repo $WORK/repo-a --identity-file key.txt --output recovered-password.txt
stderr 'key [a-f0-9]{8} does not open this repository'
! stderr 'panic'
! exists recovered-password.txt

-- password-a.txt --
password-a

-- password-b.txt --
password-b

-- key.txt --
AGE-SECRET-KEY-16HXZ3F6C8JSN9NDFCD8XLGHKS7L39M5PVCS3A53DXX5WT9SPV65Q08EAAY
