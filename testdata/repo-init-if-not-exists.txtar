env RESTIC_AGE_USER=default
env RESTIC_AGE_HOST=default.local

! exec restic-age-key repo-init --if-not-exists --repo $WORK/conflict-repo --recipients-file $WORK/conflicting.json --identity-file $WORK/key.txt
stderr 'Fatal: Invalid recipients file: conflicting entries for pubkey age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7'
! exists $WORK/conflict-repo/config

exec restic-age-key repo-init --if-not-exists --repo $WORK/repo --recipients-file $WORK/recipients.json --identity-file $WORK/key.txt
stderr 'created restic repository [a-f0-9]{10} at'
stderr 'age key [a-f0-9]{8} for alice@alice.local'
stderr 'age key [a-f0-9]{8} for bob@bob.local'

exec restic-age-key list --repo $WORK/repo --identity-file $WORK/key.txt
stdout 'age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7'
stdout 'age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw'
! stdout 'age1ljfnltkzeynhjhe928gap0jn4jlwxfwstaf2pcas3y72fv35d9qq43lvvr'

! exec restic-age-key repo-init --if-not-exists --repo $WORK/repo --recipients-file $WORK/empty.json --identity-file $WORK/key.txt
stderr 'Fatal: Recipients file contains no recipients'
! stderr 'Add key'
! stderr 'Remove key'

exec restic-age-key list --repo $WORK/repo --identity-file $WORK/key.txt
stdout 'age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7'
stdout 'age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw'
! stdout 'age1ljfnltkzeynhjhe928gap0jn4jlwxfwstaf2pcas3y72fv35d9qq43lvvr'

cp $WORK/recipients2.json $WORK/recipients2-before.json
! exec restic-age-key repo-init --if-not-exists --repo $WORK/repo --recipients-file $WORK/recipients2.json --identity-file $WORK/key.txt --output $WORK/recipients2.json
stderr '--output must not refer to the same file as --recipients-file'
cmp $WORK/recipients2-before.json $WORK/recipients2.json

exec restic-age-key repo-init --if-not-exists --repo $WORK/repo --recipients-file $WORK/recipients2.json --identity-file $WORK/key.txt --output $WORK/reconciled-keyids.txt
stderr 'repository already initialized at'
! stderr 'created restic repository'

exec restic-age-key list --repo $WORK/repo --identity-file $WORK/key.txt
stdout 'age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7'
! stdout 'age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw'
stdout 'age1ljfnltkzeynhjhe928gap0jn4jlwxfwstaf2pcas3y72fv35d9qq43lvvr'

grep '^[a-f0-9]{8}\n[a-f0-9]{8}\n$' $WORK/reconciled-keyids.txt

exec restic-age-key password --repo $WORK/repo --identity-file $WORK/key.txt --output $WORK/password.txt
exec restic key list --no-cache --json --repo $WORK/repo --password-file $WORK/password.txt
json-get stdout id
cut-chars stdout 8
sort-lines stdout
cmp stdout $WORK/reconciled-keyids.txt

exec restic-age-key repo-init --if-not-exists --repo $WORK/repo --recipients-file $WORK/recipients2.json --identity-file $WORK/key.txt --output $WORK/repeat-keyids.txt
stderr 'repository already initialized at'
cmp $WORK/reconciled-keyids.txt $WORK/repeat-keyids.txt
exec restic key list --no-cache --json --repo $WORK/repo --password-file $WORK/password.txt
json-get stdout id
cut-chars stdout 8
sort-lines stdout
cmp stdout $WORK/repeat-keyids.txt

json-find $WORK/repo/keys age-pubkey=age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7
capture-output STALE_ID
cp $WORK/repo/keys/$STALE_ID stale-key.json
json-set stale-key.json replacement-key.json hostname=new.local
sha256 replacement-key.json REPLACEMENT_ID
cp corrupt $WORK/repo/keys/$REPLACEMENT_ID
exec restic-age-key repo-init --if-not-exists --repo $WORK/repo --recipients-file $WORK/recipients3.json --identity-file $WORK/key.txt --output $WORK/repaired-keyids.txt
stderr 'repository already initialized at'
exec restic key list --no-cache --json --repo $WORK/repo --password-file $WORK/password.txt
json-get stdout id
cut-chars stdout 8
sort-lines stdout
cmp stdout $WORK/repaired-keyids.txt

exec restic-age-key list --repo $WORK/repo --identity-file $WORK/key.txt
stdout 'age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7\s+alice\s+new.local'
stdout 'age1ljfnltkzeynhjhe928gap0jn4jlwxfwstaf2pcas3y72fv35d9qq43lvvr\s+carol\s+carol.local'

-- corrupt --
corrupt

-- key.txt --
AGE-SECRET-KEY-16HXZ3F6C8JSN9NDFCD8XLGHKS7L39M5PVCS3A53DXX5WT9SPV65Q08EAAY

