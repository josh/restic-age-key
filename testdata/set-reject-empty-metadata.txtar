env RESTIC_REPOSITORY=$WORK/repo
env RESTIC_PASSWORD_FILE=$WORK/password.txt

exec restic init
exec restic-age-key add --recipient=age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw --user=alice --host=old.local
json-find $RESTIC_REPOSITORY/keys age-pubkey=age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw
capture-output VICTIM_ID
cp $RESTIC_REPOSITORY/keys/$VICTIM_ID victim-key.json
json-set victim-key.json empty-host-key.json hostname=
sha256 empty-host-key.json EMPTY_HOST_ID
cp empty-host-key.json $RESTIC_REPOSITORY/keys/$EMPTY_HOST_ID
rm $RESTIC_REPOSITORY/keys/$VICTIM_ID

! exec restic-age-key set --recipients-file=recipients.json
stderr 'hostname is empty'
! stderr 'Add key|Remove key'

exec restic-age-key list
stdout 'age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw\s+alice'
! stdout 'age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw\s+bob'

exec restic key list --no-cache --json
json-len stdout
stdout 2
! stderr .

-- password.txt --
secret

-- recipients.json --
[
    { "pubkey": "age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw" }
]
