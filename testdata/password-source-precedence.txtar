# Password sources are resolved in restic's order: command, then file, then
# RESTIC_PASSWORD.

env RESTIC_REPOSITORY=$WORK/repo
exec restic init --password-file $WORK/password.txt

# The command wins over RESTIC_PASSWORD, so the wrong environment value is
# never consulted.
env RESTIC_PASSWORD=wrong-password
exec restic key list --password-command 'print-file password.txt'
exec restic-age-key add --password-command 'print-file password.txt' --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7
stderr 'Add key'
env RESTIC_PASSWORD=

# A password file also wins over RESTIC_PASSWORD.
env RESTIC_PASSWORD=wrong-password
exec restic-age-key list --password-file $WORK/password.txt
stdout 'age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7'
env RESTIC_PASSWORD=

# RESTIC_PASSWORD is used when nothing else is given.
env RESTIC_PASSWORD=secret
exec restic-age-key list
stdout 'age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7'
env RESTIC_PASSWORD=

# An explicit --password still wins over a password command inherited from the
# environment, which is the documented way to set RESTIC_PASSWORD_COMMAND.
env RESTIC_PASSWORD_COMMAND='print-file wrong-password.txt'
exec restic-age-key list --password secret
stdout 'age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7'
env RESTIC_PASSWORD_COMMAND=

# RESTIC_PASSWORD is never shown as a flag default in help output.
env RESTIC_PASSWORD=secret
exec restic-age-key list --help
! stdout 'default "secret"'
env RESTIC_PASSWORD=

# Combining a password file and command is rejected rather than silently
# preferring one of them.
! exec restic key list --password-file $WORK/password.txt --password-command 'print-file password.txt'
stderr 'mutually exclusive'
! exec restic-age-key list --password-file $WORK/password.txt --password-command 'print-file password.txt'
! stdout .
cmp stderr conflict-stderr.txt

# The conflict is reported before any other flag validation, so neither a
# missing repository nor a missing recipients file masks it.
! exec restic-age-key list --repo $WORK/not-a-repo --password-file $WORK/password.txt --password-command 'print-file password.txt'
! stdout .
cmp stderr conflict-stderr.txt

env RESTIC_REPOSITORY=
! exec restic-age-key list --password-file $WORK/password.txt --password-command 'print-file password.txt'
! stdout .
cmp stderr conflict-stderr.txt

! exec restic-age-key set --recipients-file $WORK/absent.json --password-file $WORK/password.txt --password-command 'print-file password.txt'
! stdout .
cmp stderr conflict-stderr.txt

! exec restic-age-key set --password-file $WORK/password.txt --password-command 'print-file password.txt'
! stdout .
cmp stderr conflict-stderr.txt
env RESTIC_REPOSITORY=$WORK/repo

# The conflict is reported even when an age identity could have been used.
! exec restic-age-key list --password-file $WORK/password.txt --password-command 'print-file password.txt' --identity-file $WORK/key.txt
! stdout .
cmp stderr conflict-stderr.txt

-- password.txt --
secret

-- wrong-password.txt --
not-the-password

-- key.txt --
AGE-SECRET-KEY-16HXZ3F6C8JSN9NDFCD8XLGHKS7L39M5PVCS3A53DXX5WT9SPV65Q08EAAY

-- conflict-stderr.txt --
Fatal: Password file and command are mutually exclusive options
