env RESTIC_AGE_USER=alice
env RESTIC_AGE_HOST=alice.local

exec restic-age-key repo-init --if-not-exists --repo $WORK/repo --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7 --identity-file $WORK/key.txt --output $WORK/initial-keyid.txt
stderr 'created restic repository [a-f0-9]{10} at'
! stdout .

exec restic-age-key repo-init --if-not-exists --repo $WORK/repo --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7 --identity-file $WORK/key.txt --output $WORK/repeat-keyid.txt
stderr 'repository already initialized at'
! stderr 'created restic repository'
! stdout .
cmp $WORK/initial-keyid.txt $WORK/repeat-keyid.txt

! exec restic-age-key repo-init --if-not-exists --repo $WORK/repo --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7 --identity-file $WORK/key.txt --output $WORK/key.txt
stderr '--output must not refer to the same file as --identity-file'
! stderr 'repository already initialized'

hardlink $WORK/key.txt $WORK/key-hardlink.txt
! exec restic-age-key repo-init --if-not-exists --repo $WORK/repo --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7 --identity-file $WORK/key.txt --output $WORK/key-hardlink.txt
stderr '--output must not refer to the same file as --identity-file'

symlink $WORK/key-symlink.txt -> $WORK/key.txt
! exec restic-age-key repo-init --if-not-exists --repo $WORK/repo --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7 --identity-file $WORK/key.txt --output $WORK/key-symlink.txt
stderr '--output must not refer to the same file as --identity-file'

exec restic-age-key repo-init --if-not-exists --repo $WORK/repo --recipient age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw --identity-file $WORK/key.txt
stderr 'repository already initialized at'
! stderr 'created restic repository'

! exec restic-age-key repo-init --if-not-exists --repo $WORK/repo --recipient age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw --identity-file $WORK/key.txt --output $WORK/missing-keyid.txt
stderr 'recipient age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw is not present in the existing repository'
! exists $WORK/missing-keyid.txt

exec restic-age-key list --repo $WORK/repo --identity-file $WORK/key.txt
stdout 'age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7'
! stdout 'age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw'

