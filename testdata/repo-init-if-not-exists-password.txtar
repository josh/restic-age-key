env RESTIC_REPOSITORY=$WORK/repo
env RESTIC_PASSWORD_FILE=$WORK/password.txt
env RESTIC_AGE_USER=alice
env RESTIC_AGE_HOST=alice.local

exec restic init
exec restic-age-key repo-init --if-not-exists --recipients-file $WORK/recipients.json --output $WORK/keyids.txt
stderr 'Add key age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7 for alice@alice.local'
stderr 'repository already initialized at'

exec restic-age-key list
stdout 'age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7\s+alice\s+alice.local'

exec restic key list --no-cache --json
cp stdout keys.json
json-len keys.json
stdout 2
json-filter keys.json current=false
json-get stdout id
cut-chars stdout 8
sort-lines stdout
cmp stdout $WORK/keyids.txt

-- password.txt --
secret

-- recipients.json --
[
    { "host": "alice.local", "user": "alice", "pubkey": "age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7" }
]
