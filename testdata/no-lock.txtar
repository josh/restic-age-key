# list holds a non-exclusive lock like restic's key list, and --no-lock skips it
# so a read-only repository can still be inspected.

env RESTIC_REPOSITORY=$WORK/repo
env RESTIC_PASSWORD_FILE=$WORK/password.txt
exec restic init
exec restic-age-key add --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7

# Both tools accept the flag and leave no lock behind.
exec restic key list --no-lock
exec restic-age-key list --no-lock
stdout 'age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7'

exec restic-age-key list
stdout 'age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7'

# A read-only repository can only be listed with --no-lock, exactly as in restic.
chmod 0500 $WORK/repo/locks
! exec restic key list
! exec restic-age-key list
! stdout .
stderr 'failed to lock repository'

exec restic key list --no-lock
exec restic-age-key list --no-lock
stdout 'age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7'

# The password command never locks, so it keeps working on a read-only
# repository; it runs on every restic invocation as RESTIC_PASSWORD_COMMAND.
exec restic-age-key password --identity-file $WORK/key.txt
stdout '^[a-f0-9]{64}$'

chmod 0700 $WORK/repo/locks

# --no-lock is accepted by the other commands too, as restic accepts it
# everywhere, and writers keep locking regardless.
exec restic-age-key add --no-lock --recipient age1g5wluv38nl0vj6p3f7slgq6x4fxexwaqpqt3nctgs9n8jqf6g9wq5ywxfw
stderr 'Add key'

-- password.txt --
secret

-- key.txt --
AGE-SECRET-KEY-16HXZ3F6C8JSN9NDFCD8XLGHKS7L39M5PVCS3A53DXX5WT9SPV65Q08EAAY
