env RESTIC_AGE_USER=alice
env RESTIC_AGE_HOST=alice.local

exec restic-age-key repo-init --repo $WORK/repo --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7 --identity-file $WORK/key.txt
stderr 'created restic repository'

cp $WORK/corrupt-key $WORK/repo/keys/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

exec restic-age-key repo-init --if-not-exists --repo $WORK/repo --recipient age1tmkxjxzan25j6rmjpuffq2ft8z45q75knm356qaypcczvsz4pvds46d9l7 --identity-file $WORK/key.txt --output $WORK/keyid.txt
stderr 'repository already initialized at'
! stderr 'failed to inspect repository keys'
grep '^[a-f0-9]{8}\n$' $WORK/keyid.txt

exec restic-age-key password --repo $WORK/repo --identity-file $WORK/key.txt
stdout '^[a-f0-9]{64}\n$'

-- key.txt --
AGE-SECRET-KEY-16HXZ3F6C8JSN9NDFCD8XLGHKS7L39M5PVCS3A53DXX5WT9SPV65Q08EAAY

-- corrupt-key --
corrupt
