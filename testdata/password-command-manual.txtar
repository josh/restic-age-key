# Demonstrates the manual password recovery pipeline documented in the README,
# so it intentionally shells out to the same external programs.
[!exec:bash] skip 'bash not installed'
[!exec:jq] skip 'jq not installed'
[!exec:base64] skip 'base64 not installed'
[!exec:xxd] skip 'xxd not installed'

exec restic init --repo $WORK/repo --password-command 'print-file password.txt'

exec restic-age-key add --repo $WORK/repo --password-command 'print-file password.txt' --recipient age1ps0wtuvsua2txxdgrr7z2wxmc4v3ul9rm2x9vpuv9p9av6tru33s8z04ea

exec bash password-command.bash
stdout [a-f0-9]{64}
! stderr .

exec restic check --repo $WORK/repo --password-command 'print-file password2.txt'
! stderr .

-- password.txt --
secret

-- key.txt --
AGE-SECRET-KEY-1LV6Z7U3GKLQS6K3UPK7KT9ZX5PDAL7L2D5CW65SK40GF2MC9C4EQ4CAWUL

-- password-command.bash --
for key in "$WORK/repo/keys"/*; do
  if ! grep --quiet "age-data" "$key"; then
    continue
  fi

  jq --raw-output '."age-data"' <"$key" | \
    base64 --decode | \
    age --decrypt --identity "$WORK/key.txt" | \
    xxd --plain --cols 64 | \
    tee password2.txt
  exit 0
done
exit 1
